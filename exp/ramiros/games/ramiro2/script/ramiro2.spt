END

# Roberta, la Muerta

ENTERING SCREEN 12
	IF TRUE
	THEN
		TEXT BOX "0ROBERTA, LA DONCELLA MUERTA"
	END

	# The trap crystal
	IF %TRAPON = 1
	THEN
		SET TILE (13, 1) = 45
	END

	# The guardian
	IF %TALISMAN3 = 0
	THEN
		SET TILE (13, 3) = 13
		SET TILE (13, 4) = 39
	END
END

PRESS FIRE AT SCREEN 12
	# Touch the crystal: a block falls on the guardian.
	IF %TRAPON = 1
	IF %TALISMAN3 = 0
	# PLAYER_TOUCHES 13, 1
	IF PLAYER IN_X 193, 223
	IF PLAYER IN_Y 1, 31
	THEN
		EXTERN 9, 8
		SET TILE (13, 3) = 44
		SHOW
		EXTERN 9, 3
		EXTERN 9, 4
		SET TILE (13, 3) = 43
		SET TILE (13, 4) = 44
		SHOW
		EXTERN 9, 10
		SET TILE (13, 3) = 44
		SET TILE (13, 4) = 0
		SHOW
		EXTERN 9, 3
		EXTERN 9, 4
		SET TILE (13, 3) = 0
		SHOW
		EXTERN 9, 3
		EXTERN 9, 4
		%TALISMAN3 = 1
	END

	# Talk to the guardian
	IF %TALISMAN3 = 0
	# PLAYER_TOUCHES 13, 4
	IF PLAYER IN_X 193, 223
	IF PLAYER IN_Y 49, 79
	THEN
		TEXT BOX "5PARECES MUY APUESTO, PERICUETO LAMECUELLOS."
		TEXT BOX "1SE HACE LO QUE SE PUEDE, Y PARA CUANDO NO, AHI ESTA EL BOTOX."
		TEXT BOX "5HMMM. >QUIERES GUSANITOS?"
	END
END

