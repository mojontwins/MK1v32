# Initial screen. La Bruja Maruja.

ENTERING SCREEN 25
	IF TRUE
	THEN
		TEXT BOX "0AHI JUSTO VIVE GONZALO..."
		DECOS
			4, 4, 41
		END
	END

	# First time: the whole screen is a fire zone -> the intro runs at once.
	# SET_FIRE_ZONE_TILES 0, 0, 15, 9
	IF %FIRSTTIME = 0
	THEN
		EXTERN 10, 0
		EXTERN 11, 0
		EXTERN 12, 254
		EXTERN 13, 159
		BREAK
	END
END

PRESS FIRE AT SCREEN 25
	# Intro
	IF %FIRSTTIME = 0
	THEN
		%FIRSTTIME = 1
		EXTERN 14, 0
		TEXT BOX "1NO SE QUE NARICES QUERRA MARUJA Y POR QUE ME HA CITADO AQUI"
		TEXT BOX "1ESPERO QUE NO SEA PARA DARME AMOR, PORQUE UNO NO ESTA HOY PARA MOVERSE MUCHO"
		# REENTER: an out of range OPANT makes the engine draw the screen
		# again and run its ENTERING sections.
		OPANT = 99
		BREAK
	END

	# La Bruja Maruja
	# PLAYER_TOUCHES 4, 4
	IF PLAYER IN_X 49, 79
	IF PLAYER IN_Y 49, 79
	IF %GAMESTATE = 0
	THEN
		TEXT BOX "2<VAYA SI HAS TARDADO, RAMIRO!"
		TEXT BOX "1ES QUE ME HA SALIDO UN PADRASTRO EN EL DEO QUE..."
		TEXT BOX "2CALLA, TRUHAN. >NO TE HAS ENTERADO? <EL MALO GONZALO SE HA LLEVADO A TU HIJA!"
		TEXT BOX "1BUENO, NO ME SUELO METER EN LA VIDA DE MI NI=A, YA ES MAYORCITA PARA..."
		TEXT BOX "2<NO, CABEZA BUQUE! QUE LA HA RAPTADO ASI, EN PLAN MAL."
		TEXT BOX "2DICE QUE QUIERE VERTE. ESTA EN SUS APOSENTOS, EN LO MAS ALTO DE CASTILLO."
		TEXT BOX "2TOMA, TE RENUEVO EL HECHIZO POSTIZO. TE HARA FALTA."
		TEXT BOX "2<RECUERDA QUE, CON EL, SOLO PUEDES SOPORTAR EL SOL UN MINUTO!"
		%GAMESTATE = 1
		%HECHIZO = 1
		BREAK
	END

	# PLAYER_TOUCHES 4, 4
	IF PLAYER IN_X 49, 79
	IF PLAYER IN_Y 49, 79
	IF %GAMESTATE = 1
	THEN
		TEXT BOX "2DEJAME, PESADICO, Y VETE A HABLAR CON GONZALO EL MALO"
		BREAK
	END

	# PLAYER_TOUCHES 4, 4
	IF PLAYER IN_X 49, 79
	IF PLAYER IN_Y 49, 79
	IF %GAMESTATE = 2
	THEN
		TEXT BOX "2<DEJA DE PERDER EL TIEMPO! <TIENES QUE DEVOLVER LAS PIEZAS DEL TALISMAN!"
		BREAK
	END

	# PLAYER_TOUCHES 4, 4
	IF PLAYER IN_X 49, 79
	IF PLAYER IN_Y 49, 79
	THEN
		TEXT BOX "2AHORA EL CASTILLO SE HA VUELTO CHUNGO DEL TODO"
	END
END

