	IF PLAYER IN_Y 17, 47
	IF %TALISMAN3 = 1
	THEN
		# 20 crosses
		DECOS
			12, 1, 29
			13, 1, 29
			12, 2, 29
			13, 2, 29
			12, 3, 29
			13, 3, 29
			12, 4, 29
			13, 4, 29
			12, 5, 29
			13, 5, 29
			1, 6, 29
			2, 6, 29
			4, 6, 29
			5, 6, 29
			6, 6, 29
			1, 8, 29
			2, 8, 29
			4, 8, 29
			5, 8, 29
			6, 8, 29
		END
		# Bats on
		%MURCIELAGO = 1
		# Close the gate, paint the piece
		SET TILE (5, 1) = 35
		SET TILE (0, 4) = 32
		%GATEX = 0
		%GATEY = 4
		INC %PIECES, 1
		%TALISMAN3 = 2
		SHOW
