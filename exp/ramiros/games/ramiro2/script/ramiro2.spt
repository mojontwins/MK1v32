# Rufino, el Marino

ENTERING SCREEN 28
	IF TRUE
	THEN
		TEXT BOX "0RUFINO, EL MARINO"
	END

	# The trap crystal
	IF %TRAPON = 1
	THEN
		SET TILE (12, 5) = 45
	END

	# The guardian
	IF %TALISMAN1 = 0
	THEN
		SET TILE (11, 7) = 13
		SET TILE (11, 8) = 37
	END
END

PRESS FIRE AT SCREEN 28
	# Touch the crystal: a block falls on the guardian.
	IF %TRAPON = 1
	IF %TALISMAN1 = 0
	# PLAYER_TOUCHES 12, 5
	IF PLAYER IN_X 177, 207
	IF PLAYER IN_Y 65, 95
	THEN
		EXTERN 9, 8
		SET TILE (11, 7) = 44
		SHOW
		EXTERN 9, 3
		EXTERN 9, 4
		SET TILE (11, 7) = 43
		SET TILE (11, 8) = 44
		SHOW
		EXTERN 9, 10
		SET TILE (11, 7) = 44
		SET TILE (11, 8) = 0
		SHOW
		EXTERN 9, 3
		EXTERN 9, 4
		SET TILE (11, 7) = 0
		SHOW
		EXTERN 9, 3
		EXTERN 9, 4
		%TALISMAN1 = 1
	END

	# Talk to the guardian
	IF %TALISMAN1 = 0
	# PLAYER_TOUCHES 11, 8
	IF PLAYER IN_X 161, 191
	IF PLAYER IN_Y 113, 143
	THEN
		TEXT BOX "3HAR HAR HAAAR... <ME CABE UN BARCO!"
		TEXT BOX "1LO SIENTO, NO ME INTERESA"
		TEXT BOX "3<ESO ES PORQUE NO HAS VISTO AUN MIS TATUAJES!"
	END
END

# Crypt 1

ENTERING SCREEN 29
	IF TRUE
	THEN
		TEXT BOX "0EL ESPELUZNANTE CHANANTE"
		DECOS
			10, 8, 42
		END
	END

	# Piece on its altar
	IF %TALISMAN1 = 2
	THEN
		SET TILE (10, 7) = 33
	END

	# Guardian gone: Ramiro notices the altar
	IF %TALISMAN1 = 1
	THEN
		TEXT BOX "1<TENGO QUE PONER EL TROZO DE TALISMAN EN ESE ALTAR!"
	END
END

PRESS FIRE AT SCREEN 29
	# PLAYER_TOUCHES 10, 8
	IF PLAYER IN_X 145, 175
	IF PLAYER IN_Y 113, 143
	IF %TALISMAN1 = 1
	THEN
		# 20 crosses
		DECOS
			3, 2, 29
			12, 2, 29
			13, 2, 29
			7, 3, 29
			8, 3, 29
			12, 3, 29
			13, 3, 29
			6, 4, 29
			9, 4, 29
			12, 4, 29
			13, 4, 29
			12, 5, 29
			13, 5, 29
			1, 6, 29
			2, 6, 29
			3, 6, 29
			4, 6, 29
			5, 6, 29
			12, 6, 29
			13, 6, 29
		END
		# Bats on
		%MURCIELAGO = 1
		# Close the gate, paint the piece
		SET TILE (10, 7) = 33
		SET TILE (0, 8) = 32
		%GATEX = 0
		%GATEY = 8
		INC %PIECES, 1
		%TALISMAN1 = 2
		SHOW
		EXTERN 9, 6
		# The rest happens in PLAYER GOT SOMETHING
	END
END
