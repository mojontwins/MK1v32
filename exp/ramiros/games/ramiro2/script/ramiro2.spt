# Fritz, el Bancario Ario

ENTERING SCREEN 17
	IF TRUE
	THEN
		TEXT BOX "0FRITZ, EL BANCARIO ARIO"
	END

	# The trap crystal
	IF %TRAPON = 1
	THEN
		SET TILE (9, 2) = 45
	END

	# The guardian
	IF %TALISMAN2 = 0
	THEN
		SET TILE (11, 7) = 13
		SET TILE (11, 8) = 38
	END
END

PRESS FIRE AT SCREEN 17
	# Touch the crystal: a block falls on the guardian.
	IF %TRAPON = 1
	IF %TALISMAN2 = 0
	# PLAYER_TOUCHES 9, 2
	IF PLAYER IN_X 129, 159
	IF PLAYER IN_Y 17, 47
	THEN
		EXTERN 9, 8
		SET TILE (11, 7) = 44
		SHOW
		EXTERN 9, 3
		EXTERN 9, 4
		SET TILE (11, 7) = 43
		SET TILE (11, 8) = 44
		SHOW
		EXTERN 9, 10
		SET TILE (11, 7) = 44
		SET TILE (11, 8) = 0
		SHOW
		EXTERN 9, 3
		EXTERN 9, 4
		SET TILE (11, 7) = 0
		SHOW
		EXTERN 9, 3
		EXTERN 9, 4
		%TALISMAN2 = 1
	END

	# Talk to the guardian
	IF %TALISMAN2 = 0
	# PLAYER_TOUCHES 11, 8
	IF PLAYER IN_X 161, 191
	IF PLAYER IN_Y 113, 143
	THEN
		TEXT BOX "4MEIN NOMBRRE ES FRITZ, EL BANCARIO ARIO"
		TEXT BOX "4NO PUEDES IMAGINARR LO QUE VOY A DESIRRTE. NI EN UN MILLON DE A=OS."
		TEXT BOX "1PRUEBA..."
		TEXT BOX "4<VENDO MOTO SEMINUEVA!"
	END
END

