	END
END

# Talisman piece 3

ENTERING SCREEN 22
	IF TRUE
	THEN
		TEXT BOX "0EL ESPANTO DE LEPANTO"
	END

	# SET_FIRE_ZONE_TILES 7, 8, 7, 8
	IF %TALISMAN3 = 0
	THEN
		SET TILE (7, 8) = 33
		EXTERN 10, 97
		EXTERN 11, 113
		EXTERN 12, 127
		EXTERN 13, 143
		TEXT BOX "1<<ES UNA DE LAS PIEZAS DEL TALISMAN ALEMAN!!"
	END
END

PRESS FIRE AT SCREEN 22
	# PLAYER_TOUCHES 7, 8
	IF %TALISMAN3 = 0
	IF PLAYER IN_X 97, 127
	IF PLAYER IN_Y 113, 143
	THEN
		%CROSSES = 0
		%TALISMAN3 = 1
		INC %PIECES, 1
		DECOS
			7, 2, 13
			8, 2, 13
			9, 2, 13
			10, 2, 13
			11, 2, 13
			12, 2, 13
			13, 2, 13
			1, 4, 13
			2, 4, 13
			3, 4, 13
			4, 4, 13
			7, 6, 13
			8, 6, 13
			9, 6, 13
			10, 6, 13
			11, 6, 13
			12, 6, 13
			13, 6, 13
			2, 7, 13
			4, 7, 13
		END
		SET TILE (0, 2) = 32
		%GATEX = 0
		%GATEY = 2
		SET TILE (7, 8) = 0
		SHOW
		%MURCIELAGO = 1
		EXTERN 9, 6
	END
END

# Talisman piece 1

ENTERING SCREEN 23
	IF TRUE
	THEN
		TEXT BOX "0LA ABOMINACION EN ACCION"
	END

	# SET_FIRE_ZONE_TILES 12, 4, 12, 4
	IF %TALISMAN1 = 0
	THEN
		SET TILE (12, 4) = 33
		EXTERN 10, 177
