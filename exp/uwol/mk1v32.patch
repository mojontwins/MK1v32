+	// splib2's IM2 table) is not there: interrupts are off, the stack is moved
+	// under the program (mainloop.h) and this code must stay below C000.
+
+	// ay_player_on: 23297 (above)
+	unsigned char is128k;
+
+	#asm
+		// B = RAM page at C000 (ROM 1)
+		.SetRAMBank
+				ld  a, 0x10
+				or  b
+				ld  bc, 0x7ffd
+				out (c), a
+				ret
+	#endasm
+
+	void __FASTCALL__ ay_play_music (unsigned char n) {
+		#asm
+				ld  a, (_is128k)
+				or  a
+				ret z
+
+				ld  e, l
+				di
+				ld  b, 1
+				call SetRAMBank
+				ld  a, e
+				push ix
+				push iy
+				call RAM1_PLAY
+				pop iy
+				pop ix
+				ld  b, 0
+				call SetRAMBank
+				ei
+		#endasm
+	}
+
+	void ay_stop_sound (void) {
+		#asm
+				ld  a, (_is128k)
+				or  a
+				ret z
+
+				di
+				ld  b, 1
+				call SetRAMBank
+				call RAM1_STOP
+				ld  b, 0
+				call SetRAMBank
+				ei
+		#endasm
+	}
+#endif
+
 void ISR (void) {	
 	#asm
 			ld  hl, _isrc
 			inc (hl)
+
+		#ifdef MODE_128K_DUAL
+				ld  a, (_is128k)
+				or  a
+				jr  z, isr_48k
+
+				ld  a, (_ay_player_on)
+				or  a
+				ret z
+
+				push bc
+				push de
+				push ix
+				push iy
+				ld  b, 1
+				call SetRAMBank
+				call RAM1_ISR
+				ld  b, 0
+				call SetRAMBank
+				pop iy
+				pop ix
+				pop de
+				pop bc
+				ret
+
+			.isr_48k
+		#endif
+
+		#ifdef SFX_IDLE_PLAYER
+				push bc
+				push de
+				call sfx_tick
+				pop de
+				pop bc
+		#endif
 	#endasm
 }
 
