diff -ruN a/src/dev/system/zxloader.asm b/src/dev/system/zxloader.asm
--- a/src/dev/system/zxloader.asm	1970-01-01 01:00:00.000000000 +0100
+++ b/src/dev/system/zxloader.asm	2026-11-15 17:14:18.604552237 +0100
@@ -0,0 +1,62 @@
+; Uwol (ZX) - tape loader, at 24000 (BASIC: CLEAR 23999, LOAD ""CODE, USR 24000)
+;
+; Loads (headerless) the screen and the game at 24200. Then, if it's a 128K,
+; the music & effects (RAM1.bin, the WYZ player) into RAM1 at C000. On a 48K
+; the last block is not loaded. As MK1v4's loader_128 (ramiro4).
+; zxsizes.inc: MAIN_SIZE, RAM1_SIZE.
+
+	org 24000
+
+	INCLUDE "zxsizes.inc"
+
+	di
+	ld  sp, 23999
+
+	; Black attributes
+	ld  hl, $5800
+	ld  de, $5801
+	ld  bc, 767
+	ld  (hl), l
+	ldir
+
+	; Screen
+	ld  ix, $4000
+	ld  de, 6912
+	call load
+
+	; Game
+	ld  ix, 24200
+	ld  de, MAIN_SIZE
+	call load
+
+	; 128K? Paging the ROM changes what's at 0001.
+	ld  bc, $7ffd
+	xor a
+	out (c), a
+	ld  a, ($0001)
+	ld  h, a
+	ld  a, $10
+	out (c), a
+	ld  a, ($0001)
+	cp  h
+	jr  z, run
+
+	; RAM1 at C000 (ROM 1, RAM 1), then back to RAM 0
+	ld  a, $11
+	out (c), a
+	ld  ix, $c000
+	ld  de, RAM1_SIZE
+	call load
+	ld  a, $10
+	ld  bc, $7ffd
+	out (c), a
+
+.run
+	jp  24200
+
+.load
+	scf
+	ld  a, $ff
+	call $0556
+	di
+	ret
diff -ruN a/src/utils/sfxcnv.bas b/src/utils/sfxcnv.bas
--- a/src/utils/sfxcnv.bas	1970-01-01 01:00:00.000000000 +0100
+++ b/src/utils/sfxcnv.bas	2026-11-15 17:14:11.914592834 +0100
@@ -0,0 +1,322 @@
+' sfxcnv v0.1 [MK1 v3.2]
+' Copyleft 2026 by The Mojon Twins
+'
+' Converts a text file of beeper sound effects to sfx.h for the ZX idle time
+' sound player (dev/sfx_player.h), and optionally writes a .wav per effect to
+' hear them, with the same timing as the player.
+'
+' The text file:
+'
+'   # comment
+'   sfx name [priority]          a new effect (SFX_NAME = its number, in order)
+'       tone  frames pitch [slide]
+'       noise frames pitch [slide]
+'       rest  frames
+'
+' frames: 50 Hz ticks. pitch: in Hz ("440") or as the player's period ("p40").
+' slide: added to the period each tick (+ = lower, - = higher).
+' The period goes from 1 (~7 KHz) to 245 (~330 Hz).
+'
+' Compile with fbc sfxcnv.bas cmdlineparser.bas
+
+#include "file.bi"
+#include "cmdlineparser.bi"
+
+Const CPU_CLOCK = 3500000
+Const T_INT = 69888 				' T-states between interrupts
+Const T_UNIT = 21 					' T-states per period unit
+Const T_TONE = 215 					' Rest of a tone half wave
+Const T_NOISE = 255 				' Rest of a noise half wave
+Const WAV_RATE = 44100
+
+Sub usage
+	Print "usage:"
+	Print
+	Print "$ sfxcnv in=sfx.txt out=sfx.h [wav=prefix] [idle=100] [slice=0] [faps=2]"
+	Print
+	Print "in      the effects, as text"
+	Print "out     the .h for the player"
+	Print "wav     write prefix + name + .wav for each effect"
+	Print "idle    % of each frame the game leaves idle (where the sound plays)"
+	Print "slice   the player's SFX_MIN_SLICE (minimum sound per frame)"
+	Print "faps    the game's MIN_FAPS_PER_FRAME"
+End Sub
+
+' Effects
+Const MAX_SFX = 64
+Const MAX_STEPS = 32
+Dim Shared As String sfxName (MAX_SFX - 1)
+Dim Shared As Integer sfxPrio (MAX_SFX - 1), sfxSteps (MAX_SFX - 1)
+Dim Shared As Integer stFrames (MAX_SFX - 1, MAX_STEPS - 1)
+Dim Shared As Integer stPeriod (MAX_SFX - 1, MAX_STEPS - 1)
+Dim Shared As Integer stSlide (MAX_SFX - 1, MAX_STEPS - 1)
+Dim Shared As Integer stFlags (MAX_SFX - 1, MAX_STEPS - 1)
+Dim Shared As Integer nSfx
+
+Function pitchToPeriod (s As String) As Integer
+	Dim As Integer p
+	If Lcase (Left (s, 1)) = "p" Then
+		p = Val (Mid (s, 2))
+	Else
+		p = Int (((CPU_CLOCK / (2 * Val (s))) - T_TONE) / T_UNIT + 0.5)
+	End If
+	If p < 1 Then p = 1
+	If p > 245 Then p = 245
+	Return p
+End Function
+
+' Splits a line into words
+Dim Shared As String words (15)
+Dim Shared As Integer nWords
+
+Sub splitWords (l As String)
+	Dim As Integer i
+	Dim As String c, w
+	nWords = 0: w = ""
+	For i = 1 To Len (l) + 1
+		c = Mid (l, i, 1)
+		If c = " " Or c = Chr (9) Or c = "" Then
+			If w <> "" And nWords < 16 Then words (nWords) = w: nWords = nWords + 1
+			w = ""
+		Else
+			w = w & c
+		End If
+	Next i
+End Sub
+
+Sub parseFile (fileName As String)
+	Dim As Integer f, cur, n, lineNo
+	Dim As String l
+	f = FreeFile
+	Open fileName For Input As #f
+	cur = -1
+	While Not Eof (f)
+		Line Input #f, l
+		lineNo = lineNo + 1
+		If Instr (l, "#") Then l = Left (l, Instr (l, "#") - 1)
+		splitWords l
+		If nWords = 0 Then Continue While
+		Select Case Lcase (words (0))
+			Case "sfx"
+				cur = nSfx: nSfx = nSfx + 1
+				sfxName (cur) = Ucase (words (1))
+				sfxPrio (cur) = 0
+				If nWords > 2 Then sfxPrio (cur) = Val (words (2))
+				sfxSteps (cur) = 0
+			Case "tone", "noise", "rest"
+				If cur < 0 Then Print "Line " & lineNo & ": step outside an effect": End 1
+				n = sfxSteps (cur): sfxSteps (cur) = n + 1
+				stFrames (cur, n) = Val (words (1))
+				If stFrames (cur, n) < 1 Then stFrames (cur, n) = 1
+				If stFrames (cur, n) > 255 Then stFrames (cur, n) = 255
+				stPeriod (cur, n) = 1: stSlide (cur, n) = 0: stFlags (cur, n) = 0
+				If Lcase (words (0)) = "rest" Then
+					stFlags (cur, n) = 2
+				Else
+					stPeriod (cur, n) = pitchToPeriod (words (2))
+					If nWords > 3 Then stSlide (cur, n) = Val (words (3))
+					If Lcase (words (0)) = "noise" Then stFlags (cur, n) = 1
+				End If
+			Case Else
+				Print "Line " & lineNo & ": what is " & words (0) & "?": End 1
+		End Select
+	Wend
+	Close #f
+End Sub
+
+Sub writeH (fileName As String, inName As String)
+	Dim As Integer f, i, j
+	f = FreeFile
+	Open fileName For Output As #f
+	Print #f, "// MTE MK1 v3.2"
+	Print #f, "// Generated by sfxcnv from " & inName & ". Don't edit."
+	Print #f, ""
+	For i = 0 To nSfx - 1
+		Print #f, "#define SFX_" & sfxName (i) & " " & i
+	Next i
+	Print #f, "#define SFX_COUNT " & nSfx
+	Print #f, ""
+	Print #f, "extern unsigned char sfx_table [];"
+	Print #f, ""
+	Print #f, "#asm"
+	Print #f, Chr (9) & "._sfx_table"
+	For i = 0 To nSfx - 1
+		Print #f, Chr (9) & Chr (9) & Chr (9) & "defw sfx_" & Lcase (sfxName (i))
+	Next i
+	For i = 0 To nSfx - 1
+		Print #f, Chr (9) & ".sfx_" & Lcase (sfxName (i))
+		Print #f, Chr (9) & Chr (9) & Chr (9) & "defb " & sfxPrio (i)
+		For j = 0 To sfxSteps (i) - 1
+			Print #f, Chr (9) & Chr (9) & Chr (9) & "defb " & stFrames (i, j) & ", " & stPeriod (i, j) & ", " & (stSlide (i, j) And 255) & ", " & stFlags (i, j)
+		Next j
+		Print #f, Chr (9) & Chr (9) & Chr (9) & "defb 0"
+	Next i
+	Print #f, "#endasm"
+	Close #f
+End Sub
+
+' ----------------------------------------------------------------------------
+' WAV preview: the same as the player. Each game frame is faps interrupts; the
+' game takes (100 - idle) % of it, then the sound plays until the frame ends
+' (at least `slice` units). The ISR advances the effect every T_INT T-states.
+' ----------------------------------------------------------------------------
+
+Dim Shared As Integer wavLevel (WAV_RATE * 10)
+Dim Shared As Integer wavLen
+
+Sub wavSpeaker (t0 As Double, t1 As Double, level As Integer)
+	' Speaker at level from t0 to t1 (T-states)
+	Dim As Integer s0, s1, s
+	s0 = Int (t0 * WAV_RATE / CPU_CLOCK)
+	s1 = Int (t1 * WAV_RATE / CPU_CLOCK)
+	If s1 > Ubound (wavLevel) Then s1 = Ubound (wavLevel)
+	For s = s0 To s1 - 1
+		wavLevel (s) = level
+	Next s
+	If s1 > wavLen Then wavLen = s1
+End Sub
+
+Sub writeWav (fileName As String, idle As Integer, slice As Integer, faps As Integer)
+	Dim As Integer f, i
+	Dim As uLong ul
+	Dim As uShort us
+	Dim As uByte b
+	f = FreeFile
+	Open fileName For Binary As #f
+	Put #f, , "RIFF"
+	ul = 36 + wavLen: Put #f, , ul
+	Put #f, , "WAVEfmt "
+	ul = 16: Put #f, , ul
+	us = 1: Put #f, , us 			' PCM
+	us = 1: Put #f, , us 			' mono
+	ul = WAV_RATE: Put #f, , ul
+	ul = WAV_RATE: Put #f, , ul
+	us = 1: Put #f, , us
+	us = 8: Put #f, , us
+	Put #f, , "data"
+	ul = wavLen: Put #f, , ul
+	For i = 0 To wavLen - 1
+		b = 128 + wavLevel (i) * 48
+		Put #f, , b
+	Next i
+	Close #f
+End Sub
+
+Sub preview (k As Integer, fileName As String, idle As Integer, slice As Integer, faps As Integer)
+	Dim As Double t, tInt, tFrame, tBusyEnd, tHalf
+	Dim As Integer playing, stp, frames, period, slide, flags, level, lfsr, budget, toggle, i
+	Dim As Integer endTicks
+
+	For i = 0 To Ubound (wavLevel): wavLevel (i) = 0: Next i
+	wavLen = 0
+
+	stp = 0: playing = -1: lfsr = 1: level = 0
+	frames = stFrames (k, 0): period = stPeriod (k, 0): slide = stSlide (k, 0): flags = stFlags (k, 0)
+	t = 0: tInt = T_INT
+	endTicks = 25 						' Some silence after the effect
+
+	Do
+		' A game frame: the game is busy first
+		tFrame = t + faps * T_INT
+		tBusyEnd = t + (faps * T_INT) * (100 - idle) / 100
+		budget = slice
+		wavSpeaker t, tBusyEnd, level
+		t = tBusyEnd
+
+		' Interrupts during the busy part
+		While tInt <= t
+			If playing Then
+				frames = frames - 1
+				If frames = 0 Then
+					stp = stp + 1
+					If stp >= sfxSteps (k) Then
+						playing = 0
+					Else
+						frames = stFrames (k, stp): period = stPeriod (k, stp)
+						slide = stSlide (k, stp): flags = stFlags (k, stp)
+					End If
+				Else
+					period = period + slide
+					If period < 1 Then period = 1
+					If period > 245 Then period = 245
+				End If
+			Else
+				endTicks = endTicks - 1
+			End If
+			tInt = tInt + T_INT
+		Wend
+
+		' Idle: sound until the frame is over (and the slice is done)
+		Do
+			If playing = 0 Or (flags And 2) Then
+				' halt: to the next interrupt
+				If t >= tFrame Then Exit Do
+				wavSpeaker t, tInt, level
+				t = tInt
+			Else
+				If budget <= 0 And t >= tFrame Then Exit Do
+				If flags And 1 Then tHalf = T_UNIT * period + T_NOISE Else tHalf = T_UNIT * period + T_TONE
+				wavSpeaker t, t + tHalf, level
+				t = t + tHalf
+				budget = budget - (period + 10)
+				toggle = -1
+				If flags And 1 Then
+					toggle = lfsr And 1
+					lfsr = lfsr Shr 1
+					If toggle Then lfsr = lfsr Xor &hB8
+				End If
+				If toggle Then level = 1 - level
+			End If
+
+			' Interrupts
+			While tInt <= t
+				If playing Then
+					frames = frames - 1
+					If frames = 0 Then
+						stp = stp + 1
+						If stp >= sfxSteps (k) Then
+							playing = 0
+						Else
+							frames = stFrames (k, stp): period = stPeriod (k, stp)
+							slide = stSlide (k, stp): flags = stFlags (k, stp)
+						End If
+					Else
+						period = period + slide
+						If period < 1 Then period = 1
+						If period > 245 Then period = 245
+					End If
+				Else
+					endTicks = endTicks - 1
+				End If
+				tInt = tInt + T_INT
+			Wend
+		Loop
+
+		If t > tFrame Then tFrame = t
+		t = tFrame
+	Loop Until endTicks <= 0 Or wavLen >= Ubound (wavLevel)
+
+	writeWav fileName, idle, slice, faps
+End Sub
+
+' ----------------------------------------------------------------------------
+
+Dim As String mandatory (1) = { "in", "out" }
+Dim As Integer i, idle, slice, faps
+
+sclpParseAttrs
+If Not sclpCheck (mandatory ()) Then usage: End 1
+
+parseFile sclpGetValue ("in")
+writeH sclpGetValue ("out"), sclpGetValue ("in")
+Print "sfxcnv: " & nSfx & " effects -> " & sclpGetValue ("out")
+
+If sclpGetValue ("wav") <> "" Then
+	idle = 100: If sclpGetValue ("idle") <> "" Then idle = Val (sclpGetValue ("idle"))
+	slice = 0: If sclpGetValue ("slice") <> "" Then slice = Val (sclpGetValue ("slice"))
+	faps = 2: If sclpGetValue ("faps") <> "" Then faps = Val (sclpGetValue ("faps"))
+	For i = 0 To nSfx - 1
+		preview i, sclpGetValue ("wav") & Lcase (sfxName (i)) & ".wav", idle, slice, faps
+	Next i
+	Print "sfxcnv: " & nSfx & " previews (" & idle & "% idle, slice " & slice & ")"
+End If
