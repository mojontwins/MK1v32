diff -ruN a/src/dev/sfx_player.h b/src/dev/sfx_player.h
--- a/src/dev/sfx_player.h	1970-01-01 01:00:00.000000000 +0100
+++ b/src/dev/sfx_player.h	2026-11-15 17:14:11.914020940 +0100
@@ -0,0 +1,235 @@
+// MTE MK1 v3.2
+// Copyleft 2011, 2026 by The Mojon Twins
+
+// sfx_player.h - ZX 48K beeper sound effects played in the idle frame time
+//
+// Instead of `halt`ing until the frame is over, the main loop calls
+// sfx_idle_wait, which makes the current effect sound until the interrupt
+// that ends the frame comes. Nothing blocks the game.
+//
+// * sfx_tick runs in the ISR (50 Hz): it advances the effect (steps, slides).
+// * sfx_play (n) starts effect n if it is at least as important as the one
+//   playing. peta_el_beeper (n) calls it.
+// * SFX_MIN_SLICE (config.h): minimum sound per frame (~21 T-states units),
+//   used when the game leaves little idle time. 0 / undefined: idle time only.
+//
+// Effects come from sfx.h, generated by utils/sfxcnv from sfx/sfx.txt. Each is
+// a priority byte, then 4 byte steps (frames, period, slide, flags), then 0.
+// period: half wave = 21 * period + ~215 T-states; slide: added each frame.
+// flags: bit 0 noise, bit 1 rest. Bit 7 of sfx_flags means "playing".
+//
+// This file goes at the end of the program (churromain.c) so the loop that
+// times the sound is out of contended memory.
+
+unsigned char sfx_flags; 					// Bit 7: playing, bit 1: rest, bit 0: noise
+unsigned char sfx_frames;
+unsigned char sfx_period;
+signed char sfx_slide;
+unsigned char sfx_prio;
+unsigned char *sfx_ptr;
+unsigned char sfx_out;
+unsigned char sfx_lfsr = 1;
+
+void __FASTCALL__ sfx_play (unsigned char n) {
+	#asm
+			add hl, hl
+			ld  de, _sfx_table
+			add hl, de
+			ld  a, (hl)
+			inc hl
+			ld  h, (hl)
+			ld  l, a 						// HL -> effect
+
+			ld  a, (_sfx_flags)
+			or  a
+			jp  p, sfx_play_go 				// Nothing playing
+
+			ld  a, (_sfx_prio)
+			cp  (hl)
+			jr  z, sfx_play_go
+			ret nc 							// Something more important is playing
+
+		.sfx_play_go
+			ld  a, (hl)
+			ld  (_sfx_prio), a
+			inc hl
+			di
+			call sfx_load_step
+			ei
+	#endasm
+}
+
+void sfx_stop (void) {
+	#asm
+			xor a
+			ld  (_sfx_flags), a
+	#endasm
+}
+
+#asm
+	// ISR, 50 Hz. Advances the current effect.
+	.sfx_tick
+			ld  a, (_sfx_flags)
+			or  a
+			ret p
+
+			ld  hl, _sfx_frames
+			dec (hl)
+			jr  z, sfx_tick_next
+
+			ld  a, (_sfx_slide)
+			or  a
+			ret z
+
+			// period += slide, inside 1..245
+			ld  e, a
+			add a, a
+			sbc a, a
+			ld  d, a
+			ld  a, (_sfx_period)
+			ld  l, a
+			ld  h, 0
+			add hl, de
+			bit 7, h
+			jr  nz, sfx_tick_min
+			ld  a, h
+			or  a
+			jr  nz, sfx_tick_max
+			ld  a, l
+			cp  246
+			jr  nc, sfx_tick_max
+			or  a
+			jr  nz, sfx_tick_set
+
+		.sfx_tick_min
+			ld  a, 1
+			jr  sfx_tick_set
+
+		.sfx_tick_max
+			ld  a, 245
+
+		.sfx_tick_set
+			ld  (_sfx_period), a
+			ret
+
+		.sfx_tick_next
+			ld  hl, (_sfx_ptr)
+
+	// HL -> step: frames (0 = end), period, slide, flags
+	.sfx_load_step
+			ld  a, (hl)
+			or  a
+			jr  z, sfx_end
+			ld  (_sfx_frames), a
+			inc hl
+			ld  a, (hl)
+			ld  (_sfx_period), a
+			inc hl
+			ld  a, (hl)
+			ld  (_sfx_slide), a
+			inc hl
+			ld  a, (hl)
+			or  0x80
+			ld  (_sfx_flags), a
+			inc hl
+			ld  (_sfx_ptr), hl
+			ret
+
+		.sfx_end
+			xor a
+			ld  (_sfx_flags), a
+			ret
+
+	// Until the next interrupt (for full screen waits), idle time only.
+	._sfx_halt
+			ld  a, (_isrc)
+			inc a
+			ld  c, a
+			ld  de, 0
+			jr  sfx_iw_loop
+
+	// Main loop: until isrc >= MIN_FAPS_PER_FRAME
+	._sfx_idle_wait
+			ld  c, MIN_FAPS_PER_FRAME
+		#ifdef SFX_MIN_SLICE
+			ld  de, SFX_MIN_SLICE
+		#else
+			ld  de, 0
+		#endif
+
+		.sfx_iw_loop
+			ld  a, (_sfx_flags)
+			and 0x82
+			cp  0x80
+			jr  nz, sfx_iw_halt 			// Not playing, or a rest
+
+			ld  a, d
+			or  e
+			jr  nz, sfx_iw_play 			// Minimum slice not done yet
+
+			ld  a, (_isrc)
+			cp  c
+			ret nc
+
+		.sfx_iw_play
+			// Half a wave
+			ld  a, (_sfx_period)
+			ld  b, a
+
+		.sfx_iw_wait
+			nop
+			nop
+			djnz sfx_iw_wait
+
+			// Slice budget -= period + 10
+			add a, 10
+			ld  l, a
+			ld  h, 0
+			ex  de, hl
+			or  a
+			sbc hl, de
+			jr  nc, sfx_iw_budget
+			ld  hl, 0
+
+		.sfx_iw_budget
+			ex  de, hl
+
+			// Tone: toggle. Noise: toggle when the LFSR says so.
+			ld  a, (_sfx_flags)
+			rrca
+			jr  nc, sfx_iw_toggle
+
+			ld  a, (_sfx_lfsr)
+			srl a
+			jr  nc, sfx_iw_no_toggle
+			xor 0xb8
+			ld  (_sfx_lfsr), a
+
+		.sfx_iw_toggle
+			ld  a, (_sfx_out)
+			xor 16
+			ld  (_sfx_out), a
+			out (254), a
+			jr  sfx_iw_loop
+
+		.sfx_iw_no_toggle
+			ld  (_sfx_lfsr), a
+			jr  sfx_iw_loop
+
+		.sfx_iw_halt
+			ld  a, (_isrc)
+			cp  c
+			ret nc
+			halt
+			jr  sfx_iw_loop
+#endasm
+
+void sfx_play_wait (unsigned char n) {
+	// For jingles in full screens: play n and wait until it is over.
+	sfx_play (n);
+	while (sfx_flags & 0x80) {
+		#asm
+				call _sfx_halt
+		#endasm
+	}
+}
