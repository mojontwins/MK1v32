# Yun CPC, load 2 (levels 5-8): patterns + tile maps (mkts_om mode=scripted, run from dev/)
#
# Mode 0 at its own resolution (a 16x16 tile is 8x16 pixels in the PNGs).
# Split palette: backgrounds use pens 0, 4, 8, 12 (pal_cnvtilesN.png), the
# hotspot tiles and sprites pens 1-3 (pal_cnvspr.png), which show over
# anything (pen = bg * 4 + sprite).
#
# One pattern pool for the whole load: the font first (patterns 0-17, same
# order as the ZX one), then the hotspot tiles and every level's tiles. Each
# tileset gives a tile map: 4 patterns per tile. The font is in background
# colour 3 of the load's first level (pale yellow in both).

cpcmode 0
brickinput off

pal ../gfx/cpc/pal_cnvtiles4.png
open ../gfx/cpc/font.png
charset 0 0 18 1 0 0 18

# tiles 16-20 (refill, star, key, -, bulb), shared by all levels
pal ../gfx/cpc/pal_cnvspr.png
open ../gfx/cpc/tsx.png
metatileset 0 0 5 1 2 2 0
output tmaps cpc/tsx_tmaps.bin

pal ../gfx/cpc/pal_cnvtiles4.png
open ../gfx/cpc/ts4.png
metatileset 0 0 16 1 2 2 0
output tmaps cpc/lvl4_tmaps.bin

pal ../gfx/cpc/pal_cnvtiles5.png
open ../gfx/cpc/ts5.png
metatileset 0 0 16 1 2 2 0
output tmaps cpc/lvl5_tmaps.bin

pal ../gfx/cpc/pal_cnvtiles6.png
open ../gfx/cpc/ts6.png
metatileset 0 0 16 1 2 2 0
output tmaps cpc/lvl6_tmaps.bin

pal ../gfx/cpc/pal_cnvtiles7.png
open ../gfx/cpc/ts7.png
metatileset 0 0 16 1 2 2 0
output tmaps cpc/lvl7_tmaps.bin

stats
output patterns cpc/patterns.bin
